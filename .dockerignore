# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# Node
frontend/node_modules
frontend/.svelte-kit

# Go
backend/vendor

# Build artifacts (will be rebuilt in Docker)
frontend/build

# Documentation (keep the CLI knowledge chunks: go:embed needs them)
*.md
!cli/pkg/mcpserver/knowledge/*.md
!skills/traceway/*.md

# Environment files (use .env.docker instead)
backend/.env
.env

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
tmp/
temp/

# Claude plans
.claude/

# Local data and unrelated dependency trees are not image inputs.
.validation.*/
benchmarks/metricsdb/results-local/
benchmarks/metricsdb/bench/
docs/node_modules/
docs/.next/
docs/out/
website/node_modules/
website/.next/
**/*.db
**/*.db-wal
**/*.db-shm
backend/storage/
**/node_modules/
