# Optional retention knobs (defaults shown). Set to 0 to disable.
# SESSION_RECORDING_RETENTION_DAYS only takes effect when STORAGE_TYPE=local.
# SQLITE_RETENTION_DAYS only takes effect when DB_TYPE=sqlite.
#SESSION_RECORDING_RETENTION_DAYS=30
#SQLITE_RETENTION_DAYS=30

# TRUSTED_PROXIES trusts a proxy's X-Forwarded-For / X-Real-IP for the real
# client IP, which every per-IP rate limit keys on and sessions record as
# client.ip. Private ranges (RFC1918,
# loopback, IPv6 ULA) are trusted by default; carrier-grade NAT is not.
# The value REPLACES the defaults, so list every hop between the client and
# this server, not just the outermost one. Use "none" to trust no proxy. Set this only when the
# proxy in front has a public address, e.g. a CDN or an external load balancer.
#TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22
#TRUSTED_PROXY_HEADER=CF-Connecting-IP

# REPORT_MAX_BODY_MB caps the decompressed /api/report and /api/profiles/ingest
# body. Default 64.
#REPORT_MAX_BODY_MB=64
