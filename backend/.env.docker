CLICKHOUSE_TLS=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=traceway
POSTGRES_USERNAME=traceway
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable
JWT_SECRET=Xt7Kj2mP9qLwNc4rVb8sYd3hFgAeZuCpDnRoWxMvBa5k
GIN_MODE=release

# Optional retention knobs (defaults shown). Set to 0 to disable.
# SESSION_RECORDING_RETENTION_DAYS only takes effect when STORAGE_TYPE=local.
# SQLITE_RETENTION_DAYS only takes effect when DB_TYPE=sqlite.
#SESSION_RECORDING_RETENTION_DAYS=30
#SQLITE_RETENTION_DAYS=30

# Proxies whose X-Forwarded-For is trusted for the real client IP, which the
# per-IP rate limits key on. Only loopback is trusted by default, so list
# every hop in front of Traceway (proxy container, ingress, CDN).
#TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,10.0.0.0/8
#TRUSTED_PROXY_HEADER=CF-Connecting-IP

# Cap on the decompressed /api/report body in megabytes. Default 64.
#REPORT_MAX_BODY_MB=64
