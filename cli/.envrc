# The CLI has no flake of its own; it shares the repo-root nixpkgs pin.
# direnv's use_flake watches ./flake.nix and ./flake.lock relative to THIS
# directory, which no longer exist -- watch the root pair explicitly so
# editing them still reloads this environment.
watch_file ../flake.nix
watch_file ../flake.lock
use flake ..#cli
source_env_if_exists .envrc.local
