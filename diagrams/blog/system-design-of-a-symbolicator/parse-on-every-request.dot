// Stage 1 "dumb version" flow. Render:
//   dot -Tsvg parse-on-every-request.dot -o parse-on-every-request.svg
// Palette matches the Traceway dark theme (app/globals.css).
digraph parse_every_request {
  bgcolor="transparent";
  rankdir=TB;
  nodesep=0.32;
  ranksep=0.42;
  pad=0.2;
  fontname="Helvetica";

  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=14,
        penwidth=1.3, margin="0.30,0.18",
        color="#283041", fillcolor="#151a24", fontcolor="#f4f6fb"];
  edge [color="#5a6374", penwidth=1.4, arrowsize=0.85,
        fontname="Helvetica", fontsize=10, fontcolor="#8a93a6"];

  req    [label=<<b>incoming stack frame</b><br/><font face="Menlo" color="#8a93a6" point-size="12">app.min.js:1:5114</font>>,
          fillcolor="#0f131c"];
  load   [label=<<b>1.&nbsp; load the debug artifact</b><br/><font color="#8a93a6" point-size="12">source map + bundle &#183; .dSYM &#183; .symbols</font>>];
  parse  [label=<<b>2.&nbsp; parse &#8594; build a lookup index</b><br/><font color="#ff9a9d" point-size="12">slow: reads the whole file, thousands of allocations</font>>,
          color="#ff5a5f", fillcolor="#1b1115"];
  search [label=<<b>3.&nbsp; search the index for the frame</b><br/><font color="#7ff0c8" point-size="12">fast: a single lookup</font>>,
          color="#22e0a8", fillcolor="#0c1714"];
  ret    [label=<<b>4.&nbsp; return the result, then drop the index</b>>];
  out    [label=<<b>resolved frame</b><br/><font face="Menlo" color="#b9a7ff" point-size="12">checkout.js:48 &#183; validateCheckout</font>>,
          color="#7c5cff", fillcolor="#15121f"];

  req -> load -> parse -> search -> ret -> out;

  ret -> load [constraint=false, tailport=e, headport=e,
               style=dashed, color="#ff5a5f", fontcolor="#ff8a8d",
               label="  next request:\l  nothing kept,\l  reload + reparse\l"];
}
