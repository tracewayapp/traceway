<mxfile host="app.diagrams.net">
  <diagram name="remote-config-capture" id="remote-config-capture">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="line" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;console.error(…)&lt;/b&gt;&lt;br&gt;&lt;i&gt;&quot;payment failed for order 1042&quot;&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="40" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="router" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;Telemetry router&lt;/b&gt;&lt;br&gt;&lt;i&gt;a rule switched console off: dropped&lt;/i&gt;" vertex="1"><mxGeometry x="420" y="40" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="engine" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;Trigger engine&lt;/b&gt;&lt;br&gt;&lt;i&gt;body contains &quot;payment failed&quot;, 3 times within 60 s&lt;/i&gt;" vertex="1"><mxGeometry x="800" y="40" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="e1" parent="1" source="line" target="router" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" parent="1" source="router" target="engine" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="dash" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;Capture in the dashboard&lt;/b&gt;&lt;br&gt;&lt;i&gt;a user, device, session or attribute; up to 24 h&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="180" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="poll" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;Next OpAMP poll&lt;/b&gt;&lt;br&gt;&lt;i&gt;or as soon as the tab regains focus&lt;/i&gt;" vertex="1"><mxGeometry x="420" y="180" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="e3" parent="1" source="dash" target="poll" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="capture" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;fillColor=#F5F5F5;" value="&lt;b&gt;Capture starts&lt;/b&gt;&lt;br&gt;&lt;i&gt;once per capture: from the trigger&#x27;s capture action (30 min, 5 min lookback, replay) or from the dashboard&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="330" width="1080" height="80" as="geometry"/></mxCell>
        <mxCell id="e4" parent="1" source="engine" target="capture" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8519;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" value="fires"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" parent="1" source="poll" target="capture" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" value="same, without the line"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="lookback" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;Upload the lookback&lt;/b&gt;&lt;br&gt;&lt;i&gt;what the ring buffer holds from the last 5 min, with the replay clip&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="480" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="self" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;Send the line itself&lt;/b&gt;&lt;br&gt;&lt;i&gt;the record that fired a capture trigger&lt;/i&gt;" vertex="1"><mxGeometry x="420" y="480" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="live" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;Stream until it ends&lt;/b&gt;&lt;br&gt;&lt;i&gt;everything collected by default, also what a rule switched off; survives page loads&lt;/i&gt;" vertex="1"><mxGeometry x="800" y="480" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="e6" parent="1" source="capture" target="lookback" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;exitX=0.1481;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
