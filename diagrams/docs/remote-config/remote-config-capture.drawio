        <mxCell id="e8" parent="1" source="capture" target="live" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;exitX=0.8519;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="tw" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;Traceway&lt;/b&gt;&lt;br&gt;&lt;i&gt;traceway.trigger.fired, traceway.capture.started and the data, under the same session id&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="650" width="1080" height="80" as="geometry"/></mxCell>
        <mxCell id="e9" parent="1" source="lookback" target="tw" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1481;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
