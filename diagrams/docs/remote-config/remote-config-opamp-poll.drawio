<mxfile host="app.diagrams.net">
  <diagram name="remote-config-opamp-poll" id="remote-config-opamp-poll">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="sdk" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;Browser SDK&lt;/b&gt;&lt;br&gt;&lt;i&gt;polls at start, every heartbeat, when the tab is visible again, 2 s after an attribute changes&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="40" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="req" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;POST /api/otel/v1/opamp&lt;/b&gt;&lt;br&gt;&lt;i&gt;instance id, resource, session.id, global attributes such as user.id, the applied hash&lt;/i&gt;" vertex="1"><mxGeometry x="420" y="40" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="handler" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;fillColor=#F5F5F5;" value="&lt;b&gt;OpAMP handler&lt;/b&gt;&lt;br&gt;&lt;i&gt;project from the token; 64 KB cap&lt;/i&gt;" vertex="1"><mxGeometry x="420" y="190" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="cache" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;Rules cache&lt;/b&gt;&lt;br&gt;&lt;i&gt;the project&#x27;s compiled rules and active captures&lt;/i&gt;" vertex="1"><mxGeometry x="420" y="330" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="saved" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;Rule or capture saved&lt;/b&gt;&lt;br&gt;&lt;i&gt;Data Collection tab or a Capture button&lt;/i&gt;" vertex="1"><mxGeometry x="840" y="330" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="eval" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;Evaluate&lt;/b&gt;&lt;br&gt;&lt;i&gt;rules in order: conditions on the attributes and a sticky rollout bucket; plus captures for this client and the plan&#x27;s limits&lt;/i&gt;" vertex="1"><mxGeometry x="420" y="470" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="render" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;Render and hash&lt;/b&gt;&lt;br&gt;&lt;i&gt;the merged rules as JSON; the document goes back only when its hash changed&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="470" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="resp" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;Response&lt;/b&gt;&lt;br&gt;&lt;i&gt;settings document and poll interval: 300 s, or 60 s under a capture&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="330" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="apply" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;fillColor=#F5F5F5;" value="&lt;b&gt;SDK applies it&lt;/b&gt;&lt;br&gt;&lt;i&gt;defaults, rules, ceilings; kept for the next page&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="190" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="e1" parent="1" source="sdk" target="req" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" parent="1" source="req" target="handler" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" parent="1" source="handler" target="cache" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" parent="1" source="saved" target="cache" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" value="invalidate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" parent="1" source="cache" target="eval" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" parent="1" source="eval" target="render" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" parent="1" source="render" target="resp" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" parent="1" source="resp" target="apply" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9" parent="1" source="apply" target="sdk" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;dashed=1;labelBackgroundColor=#FFFFFF;" value="reports it applied"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
