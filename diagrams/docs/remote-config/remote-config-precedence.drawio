<mxfile host="app.diagrams.net">
  <diagram name="remote-config-precedence" id="remote-config-precedence">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="l1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;1 · SDK defaults&lt;/b&gt;&lt;br&gt;&lt;i&gt;errors stream; breadcrumbs and replay buffer; an error clip trigger&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="30" width="700" height="64" as="geometry"/></mxCell>
        <mxCell id="l2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;2 · Rules&lt;/b&gt;&lt;br&gt;&lt;i&gt;every rule matching this client, in order; a later rule wins&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="130" width="700" height="64" as="geometry"/></mxCell>
        <mxCell id="e1" parent="1" source="l1" target="l2" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="l3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;fillColor=#F5F5F5;" value="&lt;b&gt;3 · Ceilings&lt;/b&gt;&lt;br&gt;&lt;i&gt;the app&#x27;s init() options and the plan&#x27;s limits; nothing goes past them&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="230" width="700" height="64" as="geometry"/></mxCell>
        <mxCell id="e2" parent="1" source="l2" target="l3" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="l4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;" value="&lt;b&gt;4 · Timed overrides&lt;/b&gt;&lt;br&gt;&lt;i&gt;triggers stream buffered signals; captures also bring back what rules switched off&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="330" width="700" height="64" as="geometry"/></mxCell>
        <mxCell id="e3" parent="1" source="l3" target="l4" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="l5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;fillColor=#F5F5F5;" value="&lt;b&gt;5 · Kill switch&lt;/b&gt;&lt;br&gt;&lt;i&gt;a rule with enabled: false turns everything off&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="430" width="700" height="64" as="geometry"/></mxCell>
