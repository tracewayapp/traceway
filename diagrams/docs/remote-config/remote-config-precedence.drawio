        <mxCell id="eff" parent="1" style="rounded=0;whiteSpace=wrap;html=1;spacing=6;fontSize=15;fillColor=#F5F5F5;" value="&lt;b&gt;Effective mode of each signal&lt;/b&gt;&lt;br&gt;&lt;i&gt;looked up again for every record&lt;/i&gt;" vertex="1"><mxGeometry x="40" y="540" width="700" height="64" as="geometry"/></mxCell>
        <mxCell id="e5" parent="1" source="l5" target="eff" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=14;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
