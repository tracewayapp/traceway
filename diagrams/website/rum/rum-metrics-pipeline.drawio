<mxfile host="app.diagrams.net">
  <diagram name="rum-metrics-pipeline" id="rum-metrics-pipeline">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="520" math="0" shadow="0" background="#05070C">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="g1" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#3A4354;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#8A93A6;fontSize=13;" value="On the device" vertex="1"><mxGeometry x="20" y="20" width="1140" height="210" as="geometry"/></mxCell>
        <mxCell id="g2" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#3A4354;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#8A93A6;fontSize=13;" value="Traceway" vertex="1"><mxGeometry x="20" y="260" width="1140" height="240" as="geometry"/></mxCell>
        <mxCell id="b3" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=6;fontSize=14;fillColor=#0F131C;strokeColor=#3A4354;strokeWidth=1;fontColor=#F4F6FB;" value="&lt;b&gt;One observation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C9D0DD&quot;&gt;&lt;i&gt;INP 184 ms on /checkout/:id&lt;br&gt;release 4.2 · Android · phone&lt;/i&gt;&lt;/font&gt;" vertex="1"><mxGeometry x="40" y="70" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="b4" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=6;fontSize=14;fillColor=#1B1640;strokeColor=#7C5CFF;strokeWidth=2;fontColor=#F4F6FB;" value="&lt;b&gt;Histogram cell&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C9D0DD&quot;&gt;&lt;i&gt;the bucket for 184 ms goes up by one&lt;br&gt;buckets are 9% wide; at most 200 cells&lt;br&gt;held, no user or session id&lt;/i&gt;&lt;/font&gt;" vertex="1"><mxGeometry x="425" y="70" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="b5" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=6;fontSize=14;fillColor=#1B1640;strokeColor=#7C5CFF;strokeWidth=2;fontColor=#F4F6FB;" value="&lt;b&gt;One small upload&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C9D0DD&quot;&gt;&lt;i&gt;when the page is hidden, at session&lt;br&gt;end, every 5 minutes; standard OTLP&lt;br&gt;delta histograms, 64 KB at most&lt;/i&gt;&lt;/font&gt;" vertex="1"><mxGeometry x="810" y="70" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="b6" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=6;fontSize=14;fillColor=#1B1640;strokeColor=#7C5CFF;strokeWidth=2;fontColor=#F4F6FB;" value="&lt;b&gt;Merge at ingest&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C9D0DD&quot;&gt;&lt;i&gt;payloads from every device add up&lt;br&gt;bucket by bucket in memory;&lt;br&gt;one batch written every 10 seconds&lt;/i&gt;&lt;/font&gt;" vertex="1"><mxGeometry x="810" y="320" width="330" height="140" as="geometry"/></mxCell>
        <mxCell id="b7" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=6;fontSize=14;fillColor=#1B1640;strokeColor=#7C5CFF;strokeWidth=2;fontColor=#F4F6FB;" value="&lt;b&gt;Stored per minute&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C9D0DD&quot;&gt;&lt;i&gt;one row per metric, dimension set&lt;br&gt;and minute, rolled up to hours&lt;br&gt;and days; rows grow with dimensions,&lt;br&gt;not with users&lt;/i&gt;&lt;/font&gt;" vertex="1"><mxGeometry x="425" y="320" width="330" height="140" as="geometry"/></mxCell>
        <mxCell id="b8" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;spacing=6;fontSize=14;fillColor=#151A24;strokeColor=#3A4354;strokeWidth=1;fontColor=#F4F6FB;" value="&lt;b&gt;Merge, then read&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C9D0DD&quot;&gt;&lt;i&gt;p75 of any range and segment,&lt;br&gt;good / needs improvement / poor,&lt;br&gt;SLO good and total, release against&lt;br&gt;release&lt;/i&gt;&lt;/font&gt;" vertex="1"><mxGeometry x="40" y="320" width="330" height="140" as="geometry"/></mxCell>
        <mxCell id="e9" parent="1" source="b3" target="b4" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;fontSize=12;strokeColor=#7C5CFF;fontColor=#C9D0DD;labelBackgroundColor=#05070C;strokeWidth=2;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
