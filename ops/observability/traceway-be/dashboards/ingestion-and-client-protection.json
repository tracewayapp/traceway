{
  "schemaVersion": 1,
  "name": "Traceway BE - Ingestion and Client Protection",
  "description": "Backend self-monitoring: ingestion and client protection. Peak gauges and delta totals, split by bounded dimensions. New log-protection metrics require the instrumentation deployment. Storage-specific metrics and unused worker paths may be empty; empty is not zero.",
  "widgets": [
    {
      "id": "tw_74841fbedd54",
      "title": "ingest / admission rejected (total per chart bucket)",
      "widgetType": "line_chart",
      "config": {
        "sources": [
          {
            "type": "metric",
            "name": "traceway.ingest.admission_rejected.delta",
            "aggregation": "sum",
            "groupBy": "server_name"
          }
        ],
        "showLegend": true,
        "colSpan": 1,
        "size": "md"
      }
    },
