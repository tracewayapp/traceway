{
  "schemaVersion": 1,
  "name": "Traceway BE - Notifications and Workers",
  "description": "Backend self-monitoring: notifications and workers. Peak gauges and delta totals, split by bounded dimensions. New log-protection metrics require the instrumentation deployment. Storage-specific metrics and unused worker paths may be empty; empty is not zero.",
  "widgets": [
    {
      "id": "tw_66fb738eea9d",
      "title": "outbox / failed rows (peak per chart bucket)",
      "widgetType": "line_chart",
      "config": {
        "sources": [
          {
            "type": "metric",
            "name": "traceway.outbox.failed_rows",
            "aggregation": "max",
            "groupBy": "server_name"
          }
        ],
        "showLegend": true,
        "colSpan": 1,
        "size": "md"
      }
    },
