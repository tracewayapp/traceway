{
  "schemaVersion": 1,
  "name": "Traceway BE - Source Maps and Caches",
  "description": "Backend self-monitoring: source maps and caches. Peak gauges and delta totals, split by bounded dimensions. New log-protection metrics require the instrumentation deployment. Storage-specific metrics and unused worker paths may be empty; empty is not zero.",
  "widgets": [
    {
      "id": "tw_05ff8aadfd7b",
      "title": "cache / metric registry / entries (peak per chart bucket)",
      "widgetType": "line_chart",
      "config": {
        "sources": [
          {
            "type": "metric",
            "name": "traceway.cache.metric_registry.entries",
            "aggregation": "max",
            "groupBy": "server_name"
          }
        ],
        "showLegend": true,
        "colSpan": 1,
        "size": "md"
      }
    },
