{
  "schemaVersion": 1,
  "name": "Traceway BE - Storage Health",
  "description": "Backend self-monitoring: storage health. Peak gauges and delta totals, split by bounded dimensions. New log-protection metrics require the instrumentation deployment. Storage-specific metrics and unused worker paths may be empty; empty is not zero.",
  "widgets": [
    {
      "id": "tw_2a0a206b1b02",
      "title": "ch / delayed inserts (total per chart bucket)",
      "widgetType": "line_chart",
      "config": {
        "sources": [
          {
            "type": "metric",
            "name": "traceway.ch.delayed_inserts.delta",
            "aggregation": "sum",
            "groupBy": "server_name"
          }
        ],
        "showLegend": true,
        "colSpan": 1,
        "size": "md"
      }
    },
    {
      "id": "tw_6e83da9baab0",
      "title": "ch / disk / free bytes (peak per chart bucket)",
