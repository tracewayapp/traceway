VITE_API_BASE=/api

# Traceway browser SDK connection string (project token is public, baked into the bundle)
VITE_TW_CONNECTION=<project-token>@https://cloud.tracewayapp.com/api/report

# Source map upload (build-time only; the upload token is a secret, never commit it)
TRACEWAY_URL=https://cloud.tracewayapp.com
TRACEWAY_SOURCEMAP_TOKEN=<source-map-upload-token>
